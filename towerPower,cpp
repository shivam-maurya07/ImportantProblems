#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    bool check(long long target, int n, int coverage,
               long long k, vector<long long>& P) {
        long long usedK = 0;

        vector<long long> diff(n + 1, 0);

        long long effect = 0;

        for (int i = 0; i < n; i++) {

            // Add effect of towers whose range starts at i
            effect += diff[i];

            long long current_power = P[i] + effect;

            if (current_power < target) {

                long long needed = target - current_power;

                usedK += needed;

                if (usedK > k) {
                    return false;
                }

                // Newly added towers affect current index immediately
                effect += needed;

                // Place towers at i + coverage
                // They affect up to i + 2 * coverage
                long long end_idx =
                    (long long)i + 2LL * coverage + 1;

                if (end_idx < n) {
                    diff[end_idx] -= needed;
                }
            }
        }

        return true;
    }


    long long solve(int n, int coverage,
                    long long k, vector<long long>& a) {

        // P[i] = initial power received at index i
        vector<long long> P(n, 0);

        long long window_sum = 0;

        // Calculate P[0]
        for (int i = 0; i < min(n, coverage + 1); i++) {
            window_sum += a[i];
        }

        P[0] = window_sum;

        // Calculate remaining P[i] using sliding window
        for (int i = 1; i < n; i++) {

            if (i + coverage < n) {
                window_sum += a[i + coverage];
            }

            if (i - coverage - 1 >= 0) {
                window_sum -= a[i - coverage - 1];
            }

            P[i] = window_sum;
        }

        // Binary search on answer
        long long low = 0;
        long long high = 2e14;

        long long ans = 0;

        while (low <= high) {

            long long mid = low + (high - low) / 2;

            if (check(mid, n, coverage, k, P)) {

                ans = mid;
                low = mid + 1;

            } else {

                high = mid - 1;
            }
        }

        return ans;
    }
};